{
  "name": "@haakco/custd-react",
  "version": "3.14.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=10.33.2 <12"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://verdaccio.k8.haak.co/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run src"
  },
  "peerDependencies": {
    "@haakco/custd-sdk": ">=3 <4",
    "@tanstack/react-query": ">=5 <6",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@haakco/custd-sdk": "workspace:*",
    "@tanstack/react-query": "^5.104.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
