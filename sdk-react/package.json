{
  "name": "@haakco/custd-react",
  "version": "1.8.21",
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=10.33.2 <12"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://verdaccio.k8.haak.co/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run src"
  },
  "peerDependencies": {
    "@haakco/custd-sdk": ">=1.8.13 <2",
    "@tanstack/react-query": ">=5 <6",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@haakco/custd-sdk": "workspace:*",
    "@tanstack/react-query": "^5.90.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
