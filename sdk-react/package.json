{
  "name": "@haakco/custd-react",
  "version": "3.91.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./monitoring.css": "./monitoring.css"
  },
  "files": [
    "dist",
    "monitoring.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run src"
  },
  "peerDependencies": {
    "@haakco/custd-sdk": ">=3.72.0 <4",
    "@tanstack/react-query": ">=5 <6",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@haakco/custd-sdk": "workspace:*",
    "@tanstack/react-query": "^5.107.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haakco/custd-sdk.git",
    "directory": "sdk-react"
  }
}
