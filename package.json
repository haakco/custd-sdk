  },
  "pnpm": {
    "overrides": {
      "vite": "8.3.4",
      "markdown-it": "14.3.3",
      "js-yaml": "4.3.2",
      "linkify-it": "5.0.2",
      "katex": "0.18.2",
      "smol-toml": "1.9.0"
    }
  }
