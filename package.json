{
  "name": "@haakco/custd-sdk-repo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.33.2"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build:sdk-js": "pnpm --filter @haakco/custd-sdk build",
    "build:sdk-react": "pnpm --filter @haakco/custd-react build",
